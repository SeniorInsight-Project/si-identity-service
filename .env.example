# Copie para .env e preencha. O .env não é versionado.

# PostgreSQL (o Flyway cria o schema "identity" se ele não existir)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=seniorinsight
DB_USERNAME=identity
DB_PASSWORD=

# RabbitMQ (o serviço declara a exchange topic "si.events")
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_USERNAME=identity
RABBITMQ_PASSWORD=

# Keycloak: precisa ser igual ao claim "iss" dos tokens e acessível pelo serviço
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/seniorinsight

# Keycloak visto de dentro do serviço e client confidencial do pareamento do idoso (ADR 0001)
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=seniorinsight
KEYCLOAK_CLIENT_ID=si-identity-service
KEYCLOAK_CLIENT_SECRET=

# Redis (códigos de pareamento, chaves identity:pairing:*)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# care-service por REST interno (vínculo do familiar com o idoso, RF-007)
CARE_SERVICE_URL=http://localhost:8081

# Porta HTTP do serviço
SERVER_PORT=8080
