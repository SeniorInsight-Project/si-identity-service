# Copie para .env e preencha. O .env não é versionado.

# PostgreSQL (o Flyway cria o schema "identity" se ele não existir)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=seniorinsight
DB_USERNAME=identity
DB_PASSWORD=

# RabbitMQ (o serviço declara a exchange topic "si.events" e as filas identity.q e identity.dlq; o usuário precisa de
# permissão de configure/write/read nelas)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_USERNAME=identity
RABBITMQ_PASSWORD=

# Keycloak: precisa ser igual ao claim "iss" dos tokens e acessível pelo serviço
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/seniorinsight

# Keycloak visto de dentro do serviço e client confidencial do pareamento do idoso (ADR 0001)
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=seniorinsight
KEYCLOAK_CLIENT_ID=si-identity-service
KEYCLOAK_CLIENT_SECRET=

# Redis (códigos de pareamento, chaves identity:pairing:*)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# care-service por REST interno (vínculo do familiar com o idoso, RF-007)
CARE_SERVICE_URL=http://localhost:8081

# Exclusão da conta (HU-022). Todas opcionais; estes são os valores padrão.
# Routing key da si.events ligada à fila identity.q
IDENTITY_EXCLUSAO_ROUTING_KEY=lgpd.erasure.requested
# Tentativas (a primeira conta) quando o Keycloak ou o banco falham, e a espera entre elas
IDENTITY_EXCLUSAO_TENTATIVAS=5
IDENTITY_EXCLUSAO_INTERVALO=PT30S
# Prefetch do consumidor de identity.q
IDENTITY_MENSAGERIA_PREFETCH=10

# Porta HTTP do serviço
SERVER_PORT=8080
